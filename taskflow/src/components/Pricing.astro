---
---
<section class="pricing" id="pricing">
  <div class="container">
    <h2>Planos para todo tipo de time</h2>
    <div class="plans">
      <div class="plan best">
        <h3>Pro</h3>
        <div class="price">R$ 29<span>/mês</span></div>
        <ul>
          <li>Projetos e tarefas ilimitados</li>
          <li>Quadros, listas e calendário</li>
          <li>Automação e integrações</li>
          <li>Suporte prioritário</li>
        </ul>
        <a href="#" class="cta">Começar agora</a>
      </div>
      <div class="plan">
        <h3>Starter</h3>
        <div class="price">Grátis</div>
        <ul>
          <li>Até 3 projetos</li>
          <li>Quadros e listas</li>
          <li>Colaboração básica</li>
          <li>Suporte por e-mail</li>
        </ul>
        <a href="#" class="cta">Testar grátis</a>
      </div>
    </div>
  </div>
</section>

<style>
.pricing {
  background: var(--color-bg);
  padding: 5rem 0 4rem 0;
}
.pricing .container {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}
.pricing h2 {
  color: var(--color-primary);
  font-size: 2.1rem;
  margin-bottom: 2.2rem;
  font-weight: 800;
}
.plans {
  display: flex;
  flex-wrap: wrap;
  gap: 2.5rem;
  justify-content: center;
}
.plan {
  background: var(--color-light);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 2.2rem 1.5rem 2rem 1.5rem;
  min-width: 240px;
  max-width: 320px;
  border: 1px solid #ececec;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s, box-shadow 0.2s;
  position: relative;
}
.plan.best {
  border: 2px solid var(--color-primary);
  box-shadow: 0 8px 32px 0 rgba(124, 58, 237, 0.13);
  z-index: 1;
}
.plan h3 {
  color: var(--color-primary);
  font-size: 1.2rem;
  margin-bottom: 0.7rem;
  font-weight: 700;
}
.price {
  color: var(--color-secondary);
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 1.2rem;
}
.price span {
  font-size: 1rem;
  color: var(--color-dark);
  font-weight: 400;
}
ul {
  list-style: none;
  padding: 0;
  margin: 0 0 1.5rem 0;
}
ul li {
  color: var(--color-dark);
  font-size: 1.05rem;
  margin-bottom: 0.5rem;
  opacity: 0.93;
}
.cta {
  display: inline-block;
  background: var(--color-primary);
  color: var(--color-light);
  font-weight: 700;
  padding: 0.8rem 2rem;
  border-radius: var(--radius);
  font-size: 1rem;
  box-shadow: 0 2px 16px 0 rgba(124, 58, 237, 0.10);
  transition: background 0.2s, color 0.2s, transform 0.2s;
  text-transform: uppercase;
  letter-spacing: 1px;
}
.cta:hover {
  background: var(--color-secondary);
  color: var(--color-light);
  transform: translateY(-2px) scale(1.04);
}
</style>
