      <a href="#testimonials">Depoimentos</a>
      <a href="#pricing">Planos</a>
    </nav>
    <div class="copy">&copy; 2026 Taskflow. Todos os direitos reservados.</div>
  </div>
</footer>

<style>
.footer {
  background: var(--color-primary);
  color: var(--color-light);
  padding: 2.5rem 0 1.5rem 0;
  text-align: center;
}
.footer .container {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.2rem;
}
.brand {
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: -1px;
  margin-bottom: 0.5rem;
}
nav {
  display: flex;
  gap: 2rem;
  margin-bottom: 0.5rem;
}
nav a {
  color: var(--color-light);
  font-weight: 500;
  opacity: 0.92;
  transition: color 0.2s, opacity 0.2s;
}
nav a:hover {
  color: var(--color-secondary);
  opacity: 1;
}
.copy {
  font-size: 0.95rem;
  opacity: 0.85;
}
</style>
